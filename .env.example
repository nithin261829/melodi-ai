# Copy to .env and fill in. .env is git-ignored.

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# MELODI_MODEL=claude-opus-5-5
# MELODI_EFFORT=low

# Optional shared secret; the app sends it as X-Melodi-Token. Leave empty for local testing.
MELODI_APP_TOKEN=
